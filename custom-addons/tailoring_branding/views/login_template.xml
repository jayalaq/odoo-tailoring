<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Customize the login page -->
    <template id="brand_login_page" inherit_id="web.login" name="Tailoring Consult ERP Login">
        <!-- Replace page title -->
        <xpath expr="//title" position="replace">
            <title>Tailoring Consult ERP</title>
        </xpath>
        <!-- Replace the "Powered by" text in login footer -->
        <xpath expr="//div[hasclass('o_footer')]" position="replace">
            <div class="o_footer text-center text-muted mt-3">
                <small>Tailoring Consult ERP &amp;copy; 2024</small>
            </div>
        </xpath>
    </template>

</odoo>
