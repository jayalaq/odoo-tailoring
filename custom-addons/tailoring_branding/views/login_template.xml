<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add branding to the login page -->
    <template id="brand_login_page" inherit_id="web.login" name="Tailoring Consult ERP Login">
        <xpath expr="//div[hasclass('oe_structure')]" position="before">
            <div class="text-center text-muted mb-3">
                <small>Tailoring Consult ERP</small>
            </div>
        </xpath>
    </template>

</odoo>
