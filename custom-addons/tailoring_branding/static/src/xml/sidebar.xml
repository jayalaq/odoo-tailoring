<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="tailoring_branding.AppSidebar">
        <aside class="tc_sidebar d-print-none"
            t-att-class="{
                'tc_sidebar--collapsed': !isExpanded,
                'tc_sidebar--expanded': isExpanded,
            }">

            <!-- Logo / Brand -->
            <div class="tc_sidebar__brand">
                <a href="/odoo" class="tc_sidebar__logo">
                    <i class="fa fa-scissors tc_sidebar__logo-icon"/>
                    <span t-if="isExpanded" class="tc_sidebar__logo-text">TC ERP</span>
                </a>
                <button t-if="isExpanded" class="tc_sidebar__toggle" t-on-click="toggleCollapse" title="Colapsar">
                    <i class="fa fa-angle-double-left"/>
                </button>
            </div>

            <!-- Expand button when collapsed -->
            <div t-if="!isExpanded" class="tc_sidebar__expand">
                <button class="tc_sidebar__toggle" t-on-click="toggleCollapse" title="Expandir">
                    <i class="fa fa-angle-double-right"/>
                </button>
            </div>

            <!-- App Navigation -->
            <nav class="tc_sidebar__nav">
                <t t-foreach="apps" t-as="app" t-key="app.id">
                    <a class="tc_sidebar__item"
                        t-att-class="{ 'tc_sidebar__item--active': currentApp and currentApp.id === app.id }"
                        t-att-href="getMenuItemHref(app)"
                        t-att-title="app.name"
                        t-on-click.prevent="() => this.selectApp(app)">
                        <div class="tc_sidebar__item-icon">
                            <img t-if="app.webIconData"
                                t-att-src="app.webIconData"
                                class="tc_sidebar__app-img"
                                t-att-alt="app.name"/>
                            <i t-else="" class="fa fa-th-large"/>
                        </div>
                        <span t-if="isExpanded" class="tc_sidebar__item-label" t-esc="app.name"/>
                    </a>
                </t>
            </nav>

        </aside>
    </t>

</templates>
