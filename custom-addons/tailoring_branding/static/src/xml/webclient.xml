<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Override WebClient: wrap in flex row layout with sidebar -->
    <t t-name="tailoring_branding.WebClient" t-inherit="web.WebClient" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='!state.fullscreen']" position="before">
            <AppSidebar t-if="!state.fullscreen"/>
        </xpath>
    </t>

    <!-- Hide the apps menu dropdown from navbar since apps are now in sidebar -->
    <t t-name="tailoring_branding.NavBar" t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//t[@t-call='web.NavBar.AppsMenu']" position="replace">
            <!-- Apps menu moved to sidebar -->
        </xpath>
    </t>

</templates>
