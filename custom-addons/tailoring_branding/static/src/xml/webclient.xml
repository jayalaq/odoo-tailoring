<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Override WebClient: add HomeMenu before ActionContainer -->
    <t t-name="tailoring_branding.WebClient" t-inherit="web.WebClient" t-inherit-mode="extension">
        <xpath expr="//ActionContainer" position="before">
            <HomeMenu t-if="homeMenuState.open" onAppSelected.bind="onHomeAppSelected"/>
        </xpath>
    </t>

    <!-- Override NavBar: replace apps dropdown with home menu toggle button -->
    <t t-name="tailoring_branding.NavBar" t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//t[@t-call='web.NavBar.AppsMenu']" position="replace">
            <div class="o_navbar_apps_menu">
                <button class="tc_home_btn" data-hotkey="h" title="Home Menu" t-on-click="toggleHomeMenu">
                    <i class="oi oi-apps"/>
                </button>
            </div>
        </xpath>
    </t>

</templates>
