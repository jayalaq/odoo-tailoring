<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Measurement Type Views -->
    <record id="view_measurement_type_tree" model="ir.ui.view">
        <field name="name">tailoring.measurement.type.tree</field>
        <field name="model">tailoring.measurement.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="unit"/>
            </list>
        </field>
    </record>

    <record id="view_measurement_type_form" model="ir.ui.view">
        <field name="name">tailoring.measurement.type.form</field>
        <field name="model">tailoring.measurement.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="unit"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_measurement_type" model="ir.actions.act_window">
        <field name="name">Measurement Types</field>
        <field name="res_model">tailoring.measurement.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Customer Measurement Views -->
    <record id="view_customer_measurement_tree" model="ir.ui.view">
        <field name="name">tailoring.customer.measurement.tree</field>
        <field name="model">tailoring.customer.measurement</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="date"/>
            </list>
        </field>
    </record>

    <record id="view_customer_measurement_form" model="ir.ui.view">
        <field name="name">tailoring.customer.measurement.form</field>
        <field name="model">tailoring.customer.measurement</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Measurements">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="measurement_type_id"/>
                                    <field name="value"/>
                                    <field name="unit"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_customer_measurement" model="ir.actions.act_window">
        <field name="name">Customer Measurements</field>
        <field name="res_model">tailoring.customer.measurement</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
