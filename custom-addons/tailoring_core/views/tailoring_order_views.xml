<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tailoring_order_tree" model="ir.ui.view">
        <field name="name">tailoring.order.tree</field>
        <field name="model">tailoring.order</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'" decoration-warning="state in ('cutting','sewing','fitting')" decoration-success="state == 'ready'" decoration-muted="state in ('delivered','cancelled')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_order"/>
                <field name="date_deadline"/>
                <field name="total_amount" sum="Total"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state in ('cutting','sewing','fitting')" decoration-success="state in ('ready','delivered')" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_tailoring_order_form" model="ir.ui.view">
        <field name="name">tailoring.order.form</field>
        <field name="model">tailoring.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cutting" string="Start Cutting" type="object" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_sewing" string="Start Sewing" type="object" class="btn-primary" invisible="state != 'cutting'"/>
                    <button name="action_fitting" string="Fitting" type="object" class="btn-primary" invisible="state != 'sewing'"/>
                    <button name="action_ready" string="Mark Ready" type="object" class="btn-primary" invisible="state != 'fitting'"/>
                    <button name="action_deliver" string="Deliver" type="object" class="btn-success" invisible="state != 'ready'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('delivered','cancelled')"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cutting,sewing,fitting,ready,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="measurement_id"/>
                        </group>
                        <group>
                            <field name="date_order"/>
                            <field name="date_deadline"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="garment_type_id"/>
                                    <field name="fabric_description"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal" sum="Total"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_amount" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Customer Notes">
                            <field name="customer_notes"/>
                        </page>
                        <page string="Internal Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_tailoring_order_search" model="ir.ui.view">
        <field name="name">tailoring.order.search</field>
        <field name="model">tailoring.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', 'in', ['confirmed','cutting','sewing','fitting'])]"/>
                <filter string="Ready" name="ready" domain="[('state', '=', 'ready')]"/>
                <filter string="Delivered" name="delivered" domain="[('state', '=', 'delivered')]"/>
                <separator/>
                <filter string="Today's Deliveries" name="today_deadline" domain="[('date_deadline', '=', context_today().strftime('%%Y-%%m-%%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Delivery Date" name="group_deadline" context="{'group_by': 'date_deadline'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tailoring_order" model="ir.actions.act_window">
        <field name="name">Tailoring Orders</field>
        <field name="res_model">tailoring.order</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_in_progress': 1}</field>
    </record>

</odoo>
