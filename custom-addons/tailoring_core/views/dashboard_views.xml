<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dashboard Action - uses existing list/form with pivot and graph -->
    <record id="action_tailoring_dashboard" model="ir.actions.act_window">
        <field name="name">Tailoring Dashboard</field>
        <field name="res_model">tailoring.order</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="context">{}</field>
    </record>

    <!-- Graph View for Dashboard -->
    <record id="view_tailoring_order_graph" model="ir.ui.view">
        <field name="name">tailoring.order.graph</field>
        <field name="model">tailoring.order</field>
        <field name="arch" type="xml">
            <graph string="Tailoring Orders" type="bar">
                <field name="state" type="col"/>
                <field name="total_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View for Dashboard -->
    <record id="view_tailoring_order_pivot" model="ir.ui.view">
        <field name="name">tailoring.order.pivot</field>
        <field name="model">tailoring.order</field>
        <field name="arch" type="xml">
            <pivot string="Tailoring Orders Analysis">
                <field name="state" type="col"/>
                <field name="partner_id" type="row"/>
                <field name="total_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Kanban View for visual workflow -->
    <record id="view_tailoring_order_kanban" model="ir.ui.view">
        <field name="name">tailoring.order.kanban</field>
        <field name="model">tailoring.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_deadline"/>
                <field name="total_amount"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_details">
                            <strong>
                                <field name="name"/>
                            </strong>
                            <div>
                                <field name="partner_id"/>
                            </div>
                            <div t-if="record.date_deadline.raw_value">
                                Delivery: <field name="date_deadline"/>
                            </div>
                            <div class="mt-1">
                                <strong>
                                    <field name="total_amount" widget="monetary"/>
                                </strong>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
