<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_garment_type_tree" model="ir.ui.view">
        <field name="name">tailoring.garment.type.tree</field>
        <field name="model">tailoring.garment.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="base_price"/>
                <field name="estimated_days"/>
            </list>
        </field>
    </record>

    <record id="view_garment_type_form" model="ir.ui.view">
        <field name="name">tailoring.garment.type.form</field>
        <field name="model">tailoring.garment.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="base_price"/>
                            <field name="estimated_days"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <group>
                        <field name="measurement_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_garment_type" model="ir.actions.act_window">
        <field name="name">Garment Types</field>
        <field name="res_model">tailoring.garment.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
